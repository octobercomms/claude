{
  "id": "carousel-to-reel",
  "name": "Carousel to reel",
  "description": "An approved social_posts storyboard replayed as a reel: each frame's still gets one deterministic camera move, its on_screen_text set in one measured type system, over a music bed.",
  "bestFor": "A carousel whose words are already signed off and which now has to exist as a reel; nothing is re-briefed, only the motion is new.",
  "register": "editorial",
  "size": {
    "width": 1080,
    "height": 1920
  },
  "fps": 30,
  "slots": [
    {
      "id": "frames",
      "kind": "still",
      "min": 4,
      "max": 7,
      "len": {
        "min": 2.2,
        "max": 3.4
      },
      "motion": "subtle",
      "trans": "fade",
      "track": 0
    },
    {
      "id": "frameText",
      "kind": "text",
      "min": 0,
      "max": 7,
      "len": {
        "min": 2.2,
        "max": 3.4
      },
      "motion": null,
      "trans": null,
      "track": 1,
      "alignTo": "frames"
    },
    {
      "id": "endCard",
      "kind": "design",
      "min": 0,
      "max": 1,
      "len": {
        "min": 1.6,
        "max": 2.4
      },
      "motion": "subtle",
      "trans": "fade",
      "track": 0
    },
    {
      "id": "bed",
      "kind": "audio",
      "min": 1,
      "max": 1,
      "len": {
        "min": 9,
        "max": 27
      },
      "motion": null,
      "trans": null,
      "track": 2
    }
  ],
  "caption": {
    "preset": "institution-soft"
  },
  "variation": {
    "motion": [
      "push-in",
      "subtle",
      "drift",
      "rise",
      "reveal"
    ],
    "trans": [
      "fade",
      "fadeblack"
    ],
    "lenJitter": 0.12
  }
}
