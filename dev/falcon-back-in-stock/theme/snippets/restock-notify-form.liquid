{%- comment -%}
  Back-in-stock sign-up. Rendered by templates/product.liquid:
    {% render 'restock-notify-form', product: product, current_variant: current_variant %}

  Posts a Shopify customer form. The customer is created (or matched by email)
  and tagged `restock-request` plus `restock-<variant_id>`. The Shopify Flow
  that sends the email reads those tags.

  The variant tag is rendered server-side for the variant on load, so a
  sign-up still records the variant if the variant script never runs. The
  script in product.liquid keeps the tag and return URL in step when the
  customer switches variant.

  {% form %} rather than a hand-written <form> so Shopify applies its spam
  protection to the endpoint.
{%- endcomment -%}
<div class="c-notify js-notify-wrap"{% if current_variant.available %} style="display:none;"{% endif %}>
  {%- form 'customer', class: 'c-notify-form js-notify-form' -%}
    <input type="hidden" name="contact[tags]" class="js-notify-tags" value="restock-request, restock-{{ current_variant.id }}">
    <input type="hidden" name="return_to" class="js-notify-return-url" value="{{ product.url }}?variant={{ current_variant.id }}">

    <label for="RestockEmail-{{ product.id }}" class="u-hide-visually">Email address</label>
    <input
      type="email"
      id="RestockEmail-{{ product.id }}"
      name="contact[email]"
      class="c-text-field u-width-1/1 js-notify-email"
      placeholder="Enter your email address"
      autocomplete="email"
      required
    >

    <label style="display:flex;align-items:flex-start;gap:6px;margin-top:8px;font-size:13px;text-align:left;">
      <input type="checkbox" name="contact[accepts_marketing]" value="true" style="margin-top:3px;">
      <span>Also send me the Falcon newsletter</span>
    </label>

    <button type="submit" class="c-btn c-btn--brand e-h4 u-width-1/1 js-notify-submit" style="margin-top:8px;">Notify Me When Back In Stock</button>

    <p style="margin-top:8px;font-size:12px;text-align:left;">
      We only use your email to tell you when this item returns, unless you tick the newsletter box.
    </p>
  {%- endform -%}
</div>
