# Shopify app credentials (from your Partners dashboard / `shopify app config link`).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Comma-separated scopes — must match shopify.app.toml.
SCOPES=read_orders,read_customers,read_products,read_inventory,read_themes

# Public URL where the app is hosted (the tunnel URL in dev, the real host in prod).
SHOPIFY_APP_URL=https://shopify-app.octobercomms.com

# Prisma session store. SQLite for local dev; swap to Postgres/MySQL in production.
DATABASE_URL="file:./prisma/dev.sqlite"

# October MI platform — where this app forwards pairing requests and webhook events.
OMI_PLATFORM_BASE_URL=https://platform.octobercomms.com

# Shared secret used to sign forwarded webhook payloads so the platform can trust
# they originated from this app (HMAC-SHA256 over the request body).
OMI_FORWARD_SECRET=
