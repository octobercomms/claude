# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=4300
NODE_ENV=development
# Public base URL of this backend (used to build the Xero redirect URI)
APP_BASE_URL=http://localhost:4300

# --- Database (own Postgres database, own credentials) ---
DATABASE_URL=postgres://oas:password@localhost:5432/october_accounting_support

# --- Secrets encryption ---
# 32-byte key as 64 hex chars. Generate: openssl rand -hex 32
SECRETS_KEY=

# --- Xero OAuth2 app (developer.xero.com) ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Must match the redirect URI registered on the Xero app exactly
XERO_REDIRECT_URI=http://localhost:4300/auth/xero/callback

# --- Reconciliation posture ---
# false = read-only shakedown: classify and queue, write nothing to Xero.
# true  = write approved coded transactions back to Xero.
WRITE_BACK_ENABLED=false

# --- Anthropic (long-tail classification only) ---
ANTHROPIC_API_KEY=

# --- Provider APIs (added per phase, not required for Phase 1) ---
# STRIPE_API_KEY=
# GOCARDLESS_ACCESS_TOKEN=
