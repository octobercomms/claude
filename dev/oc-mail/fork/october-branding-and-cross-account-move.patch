+
+            {!loading && !error && tasks.length === 0 && (
+              <div style={{ padding: '26px 12px', textAlign: 'center', color: 'var(--text-secondary)', fontSize: 14 }}>
+                {t('tasks.empty', { defaultValue: 'Nothing here needs an action — you’re clear. 🎉' })}
+              </div>
