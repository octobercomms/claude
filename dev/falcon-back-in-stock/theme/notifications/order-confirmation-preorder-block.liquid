{%- comment -%}
  Falcon stock system: preorder block for the native ORDER CONFIRMATION email.
  Settings > Notifications > Customer notifications > Order confirmation > Edit code.
  Paste this whole file once, just above the "Order summary" section (see
  docs/falcon-back-in-stock/INSTALL-THEME.md). Renders nothing when the order has no preorder lines.

  Reads the `_preorder_date` line item property (the date promised at
  checkout), not the variant metafield. Works on all three stores: the
  store is chosen from shop.currency (GBP uk, USD us, EUR eu).

  Line item properties are read defensively: `line.properties`, falling back
  to `line.line_item.properties`, and both hash-style and name/value pairs.

  Delivery choice (mixed orders only: a pre-order line plus at least one in-stock
  line that is not the split-fee line). Reads the order attribute
  `Delivery preference` from `attributes`, falling back to `order.attributes`
  and to name/value pairs. `Ship separately` -> "In-stock items ship now.
  Pre-order items ship when they arrive." Anything else, or missing (express
  checkout that skipped the basket) -> "Everything in this order will ship
  together when the pre-order arrives."

  The split-fee line ("Second delivery") is ignored here. It is recognised by
  product handle `second-delivery`, SKU `SECOND-DELIVERY` or product title
  `Second delivery` (the notification cannot read falcon-config).
{%- endcomment -%}
{%- assign fpo_store = 'uk' -%}
{%- case shop.currency -%}
	{%- when 'USD' -%}{%- assign fpo_store = 'us' -%}
	{%- when 'EUR' -%}{%- assign fpo_store = 'eu' -%}
{%- endcase -%}
{%- if fpo_store == 'us' -%}
	{%- assign fpo_date_format = '%B %-d, %Y' -%}
	{%- assign fpo_label = 'Preorder' -%}
{%- else -%}
	{%- assign fpo_date_format = '%-d %B %Y' -%}
	{%- assign fpo_label = 'Pre-order' -%}
{%- endif -%}

{%- assign fpo_pre_count = 0 -%}
{%- assign fpo_other_count = 0 -%}
{%- capture fpo_rows -%}
	{%- for line in line_items -%}
		{%- assign fpo_handle = line.product.handle | default: '' -%}
		{%- assign fpo_ptitle = line.product.title | default: line.title | default: '' -%}
		{%- if fpo_handle == 'second-delivery' or line.sku == 'SECOND-DELIVERY' or fpo_ptitle == 'Second delivery' -%}{%- continue -%}{%- endif -%}
		{%- assign fpo_props = line.properties -%}
		{%- if fpo_props == blank -%}{%- assign fpo_props = line.line_item.properties -%}{%- endif -%}
		{%- assign fpo_date = '' -%}
		{%- if fpo_props['_preorder_date'] != blank -%}
			{%- assign fpo_date = fpo_props['_preorder_date'] -%}
		{%- else -%}
			{%- for fpo_prop in fpo_props -%}
				{%- assign fpo_key = fpo_prop.first -%}
				{%- assign fpo_val = fpo_prop.last -%}
				{%- if fpo_prop.name != blank -%}
					{%- assign fpo_key = fpo_prop.name -%}
					{%- assign fpo_val = fpo_prop.value -%}
				{%- endif -%}
				{%- if fpo_key == '_preorder_date' and fpo_val != blank -%}{%- assign fpo_date = fpo_val -%}{%- endif -%}
			{%- endfor -%}
		{%- endif -%}

		{%- if fpo_date != blank -%}
			{%- assign fpo_pre_count = fpo_pre_count | plus: 1 -%}
			{%- assign fpo_title = line.product.title | default: line.title -%}
			{%- assign fpo_variant = line.variant.title | default: line.variant_title -%}
			<tr>
				<td style="padding:0 0 12px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5;color:#333333;">
					<strong>{{ fpo_title | escape }}</strong>{% if fpo_variant != blank and fpo_variant != 'Default Title' %} ({{ fpo_variant | escape }}){% endif %} &times; {{ line.quantity }}<br>
					{{ fpo_label }}: expected to ship from {{ fpo_date | date: fpo_date_format }}.
				</td>
			</tr>
		{%- else -%}
			{%- assign fpo_other_count = fpo_other_count | plus: 1 -%}
		{%- endif -%}
	{%- endfor -%}
{%- endcapture -%}

{%- comment -%} Delivery preference (cart attribute, carried onto the order). {%- endcomment -%}
{%- assign fpo_pref = '' -%}
{%- assign fpo_attrs = attributes -%}
{%- if fpo_attrs == blank -%}{%- assign fpo_attrs = order.attributes -%}{%- endif -%}
{%- if fpo_attrs['Delivery preference'] != blank -%}
	{%- assign fpo_pref = fpo_attrs['Delivery preference'] -%}
{%- else -%}
	{%- for fpo_attr in fpo_attrs -%}
		{%- assign fpo_key = fpo_attr.first -%}
		{%- assign fpo_val = fpo_attr.last -%}
		{%- if fpo_attr.name != blank -%}
			{%- assign fpo_key = fpo_attr.name -%}
			{%- assign fpo_val = fpo_attr.value -%}
		{%- endif -%}
		{%- if fpo_key == 'Delivery preference' -%}{%- assign fpo_pref = fpo_val -%}{%- endif -%}
	{%- endfor -%}
{%- endif -%}
{%- assign fpo_pref = fpo_pref | strip -%}
{%- assign fpo_lines = fpo_pre_count | plus: fpo_other_count -%}

{%- if fpo_pre_count > 0 -%}
<table class="row section" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;border-spacing:0;">
	<tr>
		<td class="section__cell" style="padding:24px 0 8px 0;">
			<center>
				<table class="container" role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:560px;max-width:100%;text-align:left;border-collapse:collapse;border-spacing:0;margin:0 auto;">
					<tr>
						<td style="padding:16px;border:2px solid #333333;">
							<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;border-spacing:0;">
								<tr>
									<td style="padding:0 0 12px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;line-height:1.3;font-weight:bold;color:#333333;">
										{%- if fpo_store == 'us' -%}About your preorder{%- else -%}About your pre-order{%- endif -%}
									</td>
								</tr>
								{{ fpo_rows }}
								<tr>
									<td style="padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5;color:#333333;">
										{%- if fpo_store == 'us' -%}
											We'll email you when {% if fpo_pre_count > 1 %}each item is{% else %}it's{% endif %} on its way. If the date changes we'll tell you right away, and you can cancel for a full refund at any time before it ships.
										{%- else -%}
											We'll email you when {% if fpo_pre_count > 1 %}each item is{% else %}it's{% endif %} on its way. If the date changes we'll tell you straight away, and you can cancel for a full refund at any time before it's dispatched.
										{%- endif -%}
										{%- if fpo_other_count > 0 -%}
											{%- if fpo_pref == 'Ship separately' -%}
												{%- if fpo_store == 'us' %} In-stock items ship now. Preorder items ship when they arrive.{%- else %} In-stock items ship now. Pre-order items ship when they arrive.{%- endif -%}
											{%- else -%}
												{%- if fpo_store == 'us' %} Everything in this order will ship together when the preorder arrives.{%- else %} Everything in this order will ship together when the pre-order arrives.{%- endif -%}
											{%- endif -%}
										{%- endif -%}
									</td>
								</tr>
							</table>
						</td>
					</tr>
				</table>
			</center>
		</td>
	</tr>
</table>
{%- endif -%}
