# OMI Video Worker — copy to .env on the worker box and fill in.

# Platform the worker talks to, and the shared secret (set the SAME value as
# WORKER_TOKEN in the platform backend's environment).
PLATFORM_URL=https://platform.octobercomms.com
WORKER_TOKEN=

# Identify this worker in logs/claims (handy when running several).
WORKER_ID=worker-1

# Local scratch space (needs room for clips + intermediate renders).
VIDEO_WORK_DIR=/var/tmp/omi-video-work

# Poll cadence when the queue is empty (ms).
POLL_INTERVAL_MS=5000

# QA grade stage (Claude vision). Without this, cuts pass ungraded (score 85).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Captions (OpenAI Whisper). Without this, the caption stage is skipped.
# Whisper is ALSO used by the swipe-file (reel → ideas) flow to transcribe
# pasted video URLs — without a key, swipe items fail with a clear message.
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# Dead-air trim sensitivity.
SILENCE_DB=-32
SILENCE_MIN_S=0.6

# Binaries (override if not on PATH).
# NOTE: the swipe-file (reel → ideas) flow needs `yt-dlp` installed on this box
# (e.g. `pipx install yt-dlp` or `apt install yt-dlp`). Without it, swipe items
# fail gracefully; the video pipeline is unaffected.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
