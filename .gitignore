# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local

# macOS
.DS_Store

# Build output
dist/
build/
out/

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/

# Runtime artefacts — generated reports, not source
dev/platform/backend/pdfs/
# Screen recordings land here on the disk media driver (services/mediaStore).
# Uploads now spool into recordings-store/tmp first, so an interrupted upload
# leaves a part-file behind; neither it nor a real recording belongs in git.
dev/platform/backend/recordings-store/
# Caption example clips, rendered on demand from video-samples/house.mp4 and the
# preset library. Derived, tens of megabytes, and rebuilt in seconds.
dev/platform/backend/video-samples/cache/
*.zip
.claude/worktrees/

# Build/deploy artefacts — generated for handoff, not source
# (release zips + generated client theme files handed to the user)
releases/

# Client media written at runtime by the video pipelines. Never committed: a
# repository is not a media store, and these are a client's footage.
dev/platform/backend/uploads/
dev/platform/backend/video-samples/cache/
