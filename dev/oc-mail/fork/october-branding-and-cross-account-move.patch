+                    style={{ marginTop: 1, background: 'none', border: 'none', cursor: 'pointer', color: assist[b.id] ? 'var(--accent)' : 'var(--text-tertiary)', flexShrink: 0, padding: '0 2px', opacity: 0.75 }}>
