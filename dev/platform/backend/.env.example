ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=change_this_to_a_long_random_string

DB_HOST=localhost
DB_PORT=5432
DB_NAME=octoberplatform
DB_USER=octoberplatform
DB_PASSWORD=changeme

ENCRYPTION_KEY=change_this_to_32_char_hex_key_xx

CLAUDE_API_KEY=sk-ant-...

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://platform.octobercomms.com/auth/google/callback

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://platform.octobercomms.com/auth/meta/callback

GMAIL_USER=octobercommsreports@gmail.com
GMAIL_APP_PASSWORD=

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=

N8N_WEBHOOK_BASE_URL=

ALERT_EMAIL=daniel@octobercomms.com
PLATFORM_URL=https://platform.octobercomms.com
NODE_ENV=production
PORT=3001

# Daily TLS-expiry watch (services/tlsMonitor.js). Comma-separated hostnames to
# check; emails ALERT_EMAIL when any served cert is within TLS_ALERT_DAYS of
# expiry or a host is unreachable. Defaults to the PLATFORM_URL host if unset —
# set it explicitly to cover every cert on the box.
TLS_MONITOR_DOMAINS=platform.octobercomms.com,omi.octobercomms.com,shopify-app.octobercomms.com
TLS_ALERT_DAYS=14

# In-OMI screen recorder storage (docs/omi/loom-replacement-plan.md).
# Defaults to local disk; set MEDIA_STORE=r2 + the R2_* vars to use Cloudflare R2.
MEDIA_STORE=disk
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=omi-recordings
