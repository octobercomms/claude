      "id": "quote",
      "kind": "design",
      "min": 3,
      "max": 4,
      "len": {
        "min": 3.4,
        "max": 4.0
      },
      "motion": "subtle",
      "trans": "fade",
      "track": 0
    },
    {
      "id": "attribution",
      "kind": "text",
      "min": 1,
      "max": 1,
      "len": {
        "min": 2.6,
        "max": 3.4
      },
      "motion": "subtle",
      "trans": "fade",
      "track": 1
    }
  ],
  "caption": {
    "preset": "gallery-quiet"
  },
  "variation": {
    "motion": [
      "subtle",
      "drift",
      "rise"
    ],
    "trans": [
      "fade",
      "fadeblack"
    ],
    "lenJitter": 0.12
  }
